{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Feature Tour (.NET 10, x86)",
      "type": "netdbg",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/x86/Debug/net10.0-windows/FeatureTour.exe",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Feature Tour (.NET Framework 4.8, x86)",
      "type": "netdbg",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/x86/Debug/net48/FeatureTour.exe",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Attach (pick a process)",
      "type": "netdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Attach (wait for FeatureTour to start)",
      "type": "netdbg",
      "request": "attach",
      "processName": "FeatureTour",
      "waitTimeout": 120
    }
  ]
}
