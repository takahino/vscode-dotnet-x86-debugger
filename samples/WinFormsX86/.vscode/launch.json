{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET x86 Launch",
      "type": "netdbg",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/x86/Debug/net10.0-windows/WinFormsX86.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false
    },
    {
      "name": ".NET x86 Attach",
      "type": "netdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
