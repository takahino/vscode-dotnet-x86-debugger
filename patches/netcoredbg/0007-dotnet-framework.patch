+// .NET Framework (desktop CLR) support.
+// dbgshim only knows CoreCLR. For .NET Framework the ICorDebug of the desktop CLR (mscordbi v4) is obtained through
+// mscoree's ICLRMetaHost, and it creates / attaches to the process itself. ManagedPart (PDB reading, expression parsing)
+// still needs a CoreCLR to run on, which the debuggee does not have, so a CoreCLR given by the caller is hosted instead.
+//   NETCOREDBG_DESKTOP_CLR=1             launch the program with the desktop CLR
+//   NETCOREDBG_HOST_CORECLR=<coreclr.dll> CoreCLR (same bitness as netcoredbg) to run ManagedPart on
+static bool IsDesktopClrRequested()
+{
+    const char *value = getenv("NETCOREDBG_DESKTOP_CLR");
+    return value != nullptr && value[0] == '1';
+}
+
+static std::string GetHostCoreClrPath()
+{
+    const char *value = getenv("NETCOREDBG_HOST_CORECLR");
+    return value != nullptr ? std::string(value) : std::string();
+}
+
+#ifdef _WIN32
+// Minimal declarations from metahost.h (.NET Framework SDK), which conflicts with the CoreCLR headers used here.
+// Only the methods up to the ones called are declared; the vtable order must match metahost.h.
+struct ICLRMetaHostMin : public IUnknown
+{
+    virtual HRESULT STDMETHODCALLTYPE GetRuntime(LPCWSTR pwzVersion, REFIID riid, LPVOID *ppRuntime) = 0;
+};
+struct ICLRRuntimeInfoMin : public IUnknown
+{
+    virtual HRESULT STDMETHODCALLTYPE GetVersionString(LPWSTR pwzBuffer, DWORD *pcchBuffer) = 0;
+    virtual HRESULT STDMETHODCALLTYPE GetRuntimeDirectory(LPWSTR pwzBuffer, DWORD *pcchBuffer) = 0;
+    virtual HRESULT STDMETHODCALLTYPE IsLoaded(HANDLE hndProcess, BOOL *pbLoaded) = 0;
+    virtual HRESULT STDMETHODCALLTYPE LoadErrorString(UINT iResourceID, LPWSTR pwzBuffer, DWORD *pcchBuffer, LONG iLocaleID) = 0;
+    virtual HRESULT STDMETHODCALLTYPE LoadLibrary(LPCWSTR pwzDllName, HMODULE *phndModule) = 0;
+    virtual HRESULT STDMETHODCALLTYPE GetProcAddress(LPCSTR pszProcName, LPVOID *ppProc) = 0;
+    virtual HRESULT STDMETHODCALLTYPE GetInterface(REFCLSID rclsid, REFIID riid, LPVOID *ppUnk) = 0;
+};
+static const GUID CLSID_CLRMetaHost_ = {0x9280188d, 0x0e8e, 0x4867, {0xb3, 0x0c, 0x7f, 0xa8, 0x38, 0x84, 0xe8, 0xde}};
+static const GUID IID_ICLRMetaHost_ = {0xD332DB9E, 0xB9B3, 0x4125, {0x82, 0x07, 0xA1, 0x48, 0x84, 0xF5, 0x32, 0x16}};
+static const GUID IID_ICLRRuntimeInfo_ = {0xBD39D1D2, 0xBA2F, 0x486a, {0x89, 0xB0, 0xB4, 0xB0, 0xCB, 0x46, 0x68, 0x91}};
+static const GUID CLSID_CLRDebuggingLegacy_ = {0xDF8395B5, 0xA4BA, 0x450b, {0xA7, 0x7C, 0xA9, 0xA4, 0x77, 0x62, 0xC5, 0x20}};
+
+static HRESULT CreateDesktopCorDebug(ICorDebug **ppCorDebug)
+{
+    typedef HRESULT (STDAPICALLTYPE *CLRCreateInstanceFn)(REFCLSID clsid, REFIID riid, LPVOID *ppInterface);
+    HMODULE mscoree = ::LoadLibraryW(L"mscoree.dll");
+    if (mscoree == nullptr)
+    {
+        LOGE("Desktop CLR: mscoree.dll not found. Is .NET Framework 4 installed?");
+        return HRESULT_FROM_WIN32(GetLastError());
+    }
+    auto createInstance = reinterpret_cast<CLRCreateInstanceFn>(::GetProcAddress(mscoree, "CLRCreateInstance"));
+    if (createInstance == nullptr)
+        return E_NOINTERFACE;
+
+    HRESULT Status;
+    ToRelease<ICLRMetaHostMin> pMetaHost;
+    IfFailRet(createInstance(CLSID_CLRMetaHost_, IID_ICLRMetaHost_, (LPVOID *)&pMetaHost));
+    ToRelease<ICLRRuntimeInfoMin> pRuntime;
+    // Every .NET Framework 4.x (4.0 - 4.8.1) is the in-place update of the v4.0.30319 runtime.
+    IfFailRet(pMetaHost->GetRuntime(L"v4.0.30319", IID_ICLRRuntimeInfo_, (LPVOID *)&pRuntime));
+    return pRuntime->GetInterface(CLSID_CLRDebuggingLegacy_, IID_ICorDebug, (LPVOID *)ppCorDebug);
+}
