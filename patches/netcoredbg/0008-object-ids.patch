+// Object IDs ("Make Object ID", as in Visual Studio): weak GC handles to objects, so the same object can be reached
+// from any frame and any later stop as __DOTNETX86_OBJID_<N>, which the extension shows as $<N> (C# allows no digit after $).
+// Weak like Visual Studio's: an object ID does not keep its object alive; once collected it evaluates to null.
+static const char OBJECT_ID_PREFIX[] = "__DOTNETX86_OBJID_";
+static std::mutex g_objectIdsMutex;
+static std::map<int, ToRelease<ICorDebugHandleValue>> g_objectIds;
+static int g_lastObjectId = 0;
+
+// Address of the object a value refers to (0 for null or a value type).
+static CORDB_ADDRESS ObjectAddress(ICorDebugValue *pValue)
+{
+    CORDB_ADDRESS address = 0;
+    ToRelease<ICorDebugReferenceValue> pRef;
+    if (SUCCEEDED(pValue->QueryInterface(IID_ICorDebugReferenceValue, (LPVOID *) &pRef)))
+    {
+        BOOL isNull = TRUE;
+        if (FAILED(pRef->IsNull(&isNull)) || isNull || FAILED(pRef->GetValue(&address)))
+            return 0;
+        return address;
+    }
+    ToRelease<ICorDebugHeapValue> pHeap;
+    if (SUCCEEDED(pValue->QueryInterface(IID_ICorDebugHeapValue, (LPVOID *) &pHeap)) && SUCCEEDED(pValue->GetAddress(&address)))
+        return address;
+    return 0;
+}
+
+// Gives the object `pValue` refers to an ID (the existing one if it has one already).
+HRESULT CreateObjectId(ICorDebugValue *pValue, int &id)
+{
+    HRESULT Status;
+    CORDB_ADDRESS address = ObjectAddress(pValue);
+    if (address == 0)
+        return E_INVALIDARG; // null, or a value type: nothing on the heap to point to
+
+    std::lock_guard<std::mutex> lock(g_objectIdsMutex);
+    for (auto &entry : g_objectIds)
+    {
+        if (ObjectAddress(entry.second) == address)
+        {
+            id = entry.first;
+            return S_OK;
+        }
+    }
+
+    ToRelease<ICorDebugValue> pObject;
+    ToRelease<ICorDebugReferenceValue> pRef;
+    if (SUCCEEDED(pValue->QueryInterface(IID_ICorDebugReferenceValue, (LPVOID *) &pRef)))
+    {
+        IfFailRet(pRef->Dereference(&pObject));
+    }
+    else
+    {
+        pValue->AddRef();
+        pObject = pValue;
+    }
+    ToRelease<ICorDebugHeapValue2> pHeap;
+    IfFailRet(pObject->QueryInterface(IID_ICorDebugHeapValue2, (LPVOID *) &pHeap));
+    ToRelease<ICorDebugHandleValue> pHandle;
+    IfFailRet(pHeap->CreateHandle(HANDLE_WEAK_TRACK_RESURRECTION, &pHandle));
+    id = ++g_lastObjectId;
+    g_objectIds.emplace(id, std::move(pHandle));
+    return S_OK;
+}
+
+// " {$N}" when the value refers to an object that has an ID, so the Variables view shows it.
+std::string ObjectIdSuffix(ICorDebugValue *pValue)
+{
+    std::lock_guard<std::mutex> lock(g_objectIdsMutex);
+    if (g_objectIds.empty() || pValue == nullptr)
+        return std::string();
+    CORDB_ADDRESS address = ObjectAddress(pValue);
+    if (address == 0)
+        return std::string();
+    for (auto &entry : g_objectIds)
+    {
+        if (ObjectAddress(entry.second) == address)
+            return " {$" + std::to_string(entry.first) + "}";
+    }
+    return std::string();
+}
+
+static HRESULT FindObjectId(const std::string &identifier, ICorDebugValue **ppValue)
+{
+    int id = std::atoi(identifier.c_str() + sizeof(OBJECT_ID_PREFIX) - 1);
+    std::lock_guard<std::mutex> lock(g_objectIdsMutex);
+    auto it = g_objectIds.find(id);
+    if (it == g_objectIds.end())
+        return E_INVALIDARG;
+    return it->second->QueryInterface(IID_ICorDebugValue, (LPVOID *) ppValue);
+}
