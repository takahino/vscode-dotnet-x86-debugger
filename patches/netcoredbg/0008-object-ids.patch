+HRESULT Variables::GetReferenceValue(uint32_t variablesReference, ICorDebugValue **ppValue)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_referencesMutex);
+    auto it = m_references.find(variablesReference);
+    if (it == m_references.end() || it->second.iCorValue == nullptr)
