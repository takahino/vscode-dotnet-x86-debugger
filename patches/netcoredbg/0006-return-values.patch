+void Steppers::SetupReturnValues(ICorDebugThread *pThread, ICorDebugFrame *pFrame, IDebugger::StepType stepType)
+{
+    ThreadId threadId(getThreadId(pThread));
+    if (stepType == IDebugger::STEP_OUT)
+    {
+        m_returnValueStepOutThread = threadId;
+        return;
+    }
+
+    // Step over / into: catch the calls made by the current statement. Failures only mean no return values are shown.
+    ToRelease<ICorDebugNativeFrame> pNativeFrame;
+    ToRelease<ICorDebugCode> pNativeCode;
+    ToRelease<ICorDebugCode3> pNativeCode3;
+    ToRelease<ICorDebugFunction> pFunction;
+    ToRelease<ICorDebugModule> pModule;
+    COR_DEBUG_STEP_RANGE range;
+    CORDB_ADDRESS frameStart = 0, frameEnd = 0;
+    std::vector<BYTE> il;
+    if (FAILED(pFrame->QueryInterface(IID_ICorDebugNativeFrame, (LPVOID *)&pNativeFrame)) ||
+        FAILED(pNativeFrame->GetCode(&pNativeCode)) ||
+        FAILED(pNativeCode->QueryInterface(IID_ICorDebugCode3, (LPVOID *)&pNativeCode3)) ||
+        FAILED(pFrame->GetFunction(&pFunction)) ||
+        FAILED(pFunction->GetModule(&pModule)) ||
+        FAILED(pFrame->GetStackRange(&frameStart, &frameEnd)) ||
+        FAILED(m_sharedModules->GetStepRangeFromCurrentIP(pThread, &range)) ||
+        FAILED(ReadILCode(pFunction, il)))
+        return;
+
+    std::lock_guard<std::mutex> lock(m_returnValueMutex);
+    for (const auto &call : FindCalls(il, range.startOffset, range.endOffset))
+    {
+        ULONG32 offsets[8];
+        ULONG32 fetched = 0;
+        // Fails for void methods: there is nothing to show.
+        if (FAILED(pNativeCode3->GetReturnValueLiveOffset(call.first, _countof(offsets), &fetched, offsets)))
+            continue;
+        std::string name = CallName(pModule, call.second);
+        for (ULONG32 i = 0; i < fetched && i < _countof(offsets); i++)
+        {
+            ICorDebugFunctionBreakpoint *pBreakpoint = nullptr;
+            if (SUCCEEDED(pNativeCode->CreateBreakpoint(offsets[i], &pBreakpoint)))
+                m_returnValueBreakpoints.push_back({pBreakpoint, call.first, name, threadId, frameStart});
+        }
+    }
+}
+
+void Steppers::DeactivateReturnValueBreakpoints()
+{
+    std::lock_guard<std::mutex> lock(m_returnValueMutex);
+    for (auto &b : m_returnValueBreakpoints)
+    {
+        b.pBreakpoint->Activate(FALSE);
+        b.pBreakpoint->Release();
+    }
+    m_returnValueBreakpoints.clear();
+    m_returnValueStepOutThread = ThreadId{};
+}
+
+void Steppers::ClearReturnValues()
+{
+    DeactivateReturnValueBreakpoints();
+    ClearStoredReturnValues();
+}
+
+// True when the breakpoint is one of ours; the callback is then not reported to the user.
+bool Steppers::HandleReturnValueBreakpoint(ICorDebugThread *pThread, ICorDebugBreakpoint *pBreakpoint)
+{
+    ToRelease<ICorDebugFunctionBreakpoint> pFunctionBreakpoint;
+    if (pBreakpoint == nullptr ||
+        FAILED(pBreakpoint->QueryInterface(IID_ICorDebugFunctionBreakpoint, (LPVOID *)&pFunctionBreakpoint)))
+        return false;
+
+    ThreadId threadId(getThreadId(pThread));
+    bool ours = false;
+    std::string name;
+    ULONG32 callILOffset = 0;
+    {
+        std::lock_guard<std::mutex> lock(m_returnValueMutex);
+        for (auto &b : m_returnValueBreakpoints)
+        {
+            if (b.pBreakpoint != pFunctionBreakpoint.GetPtr())
+                continue;
+            ours = true;
+            ToRelease<ICorDebugFrame> pFrame;
+            CORDB_ADDRESS start = 0, end = 0;
+            // Another thread running the same code, or a recursive call, is not the call being stepped over.
+            if (b.threadId == threadId && SUCCEEDED(pThread->GetActiveFrame(&pFrame)) && pFrame != nullptr &&
+                SUCCEEDED(pFrame->GetStackRange(&start, &end)) && start == b.frameStart)
+            {
+                name = b.name;
+                callILOffset = b.callILOffset;
+            }
+            break;
+        }
+    }
+    if (!ours)
+        return false;
+    if (name.empty())
+        return true;
+
+    ToRelease<ICorDebugFrame> pFrame;
+    ToRelease<ICorDebugILFrame3> pILFrame3;
+    ToRelease<ICorDebugValue> pValue;
+    if (SUCCEEDED(pThread->GetActiveFrame(&pFrame)) && pFrame != nullptr &&
+        SUCCEEDED(pFrame->QueryInterface(IID_ICorDebugILFrame3, (LPVOID *)&pILFrame3)) &&
+        SUCCEEDED(pILFrame3->GetReturnValueForILOffset(callILOffset, &pValue)))
+    {
+        StoreReturnValue(name, pValue, threadId);
+    }
+    return true;
+}
+
+// After a step out the caller is stopped right after the call; the runtime gives the value only for the call
+// instruction whose live offset is the current position, so try the calls of the method.
+void Steppers::ReadReturnValueAfterStepOut(ICorDebugThread *pThread)
+{
+    ThreadId threadId(getThreadId(pThread));
+    {
+        std::lock_guard<std::mutex> lock(m_returnValueMutex);
+        if (!m_returnValueStepOutThread || !(m_returnValueStepOutThread == threadId))
+            return;
+        m_returnValueStepOutThread = ThreadId{};
+    }
+
+    ToRelease<ICorDebugFrame> pFrame;
+    ToRelease<ICorDebugILFrame3> pILFrame3;
+    ToRelease<ICorDebugFunction> pFunction;
+    ToRelease<ICorDebugModule> pModule;
+    std::vector<BYTE> il;
+    if (FAILED(pThread->GetActiveFrame(&pFrame)) || pFrame == nullptr ||
+        FAILED(pFrame->QueryInterface(IID_ICorDebugILFrame3, (LPVOID *)&pILFrame3)) ||
+        FAILED(pFrame->GetFunction(&pFunction)) ||
+        FAILED(pFunction->GetModule(&pModule)) ||
+        FAILED(ReadILCode(pFunction, il)))
+        return;
+
+    for (const auto &call : FindCalls(il, 0, (ULONG32)il.size()))
+    {
+        ToRelease<ICorDebugValue> pValue;
+        if (SUCCEEDED(pILFrame3->GetReturnValueForILOffset(call.first, &pValue)) && pValue != nullptr)
+        {
+            StoreReturnValue(CallName(pModule, call.second), pValue, threadId);
+            return;
+        }
+    }
+}
