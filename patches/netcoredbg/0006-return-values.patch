+    // Operand size of the IL instruction at il[offset] (ECMA-335 partition III); 0 when the opcode is unknown.
+    ULONG32 ILInstructionSize(const std::vector<BYTE> &il, ULONG32 offset)
+    {
+        BYTE op = il[offset];
+        if (op == 0xFE)
+        {
+            if (offset + 1 >= il.size())
+                return 0;
+            switch (il[offset + 1])
+            {
+            case 0x06: case 0x07: case 0x15: case 0x16: case 0x1C: return 2 + 4; // ldftn, ldvirtftn, initobj, constrained., sizeof
+            case 0x09: case 0x0A: case 0x0B: case 0x0C: case 0x0D: case 0x0E: return 2 + 2; // ldarg, ldarga, starg, ldloc, ldloca, stloc
+            case 0x12: case 0x19: return 2 + 1; // unaligned., no.
+            default: return 2;
+            }
+        }
+        if ((op >= 0x0E && op <= 0x13) || op == 0x1F || (op >= 0x2B && op <= 0x37) || op == 0xDE)
+            return 1 + 1;
+        if (op == 0x21 || op == 0x23) // ldc.i8, ldc.r8
+            return 1 + 8;
+        if (op == 0x45) // switch: count followed by count targets
+        {
+            if (offset + 5 > il.size())
+                return 0;
+            ULONG32 n = il[offset + 1] | (il[offset + 2] << 8) | (il[offset + 3] << 16) | (il[offset + 4] << 24);
+            return 1 + 4 + n * 4;
+        }
+        if (op == 0x20 || op == 0x22 || op == 0x27 || op == 0x28 || op == 0x29 || (op >= 0x38 && op <= 0x44) ||
+            (op >= 0x6F && op <= 0x75) || op == 0x79 || (op >= 0x7B && op <= 0x81) || op == 0x8C || op == 0x8D ||
+            op == 0x8F || op == 0xA3 || op == 0xA4 || op == 0xA5 || op == 0xC2 || op == 0xC6 || op == 0xD0 || op == 0xDD)
+            return 1 + 4;
+        return 1;
+    }
+
+    // call / callvirt instructions in [start, end): IL offset and method token.
+    std::vector<std::pair<ULONG32, mdToken>> FindCalls(const std::vector<BYTE> &il, ULONG32 start, ULONG32 end)
+    {
+        std::vector<std::pair<ULONG32, mdToken>> calls;
+        for (ULONG32 offset = start; offset < end && offset < il.size();)
+        {
+            ULONG32 size = ILInstructionSize(il, offset);
+            if (size == 0)
+                break;
+            if ((il[offset] == 0x28 || il[offset] == 0x6F) && offset + 5 <= il.size())
+                calls.emplace_back(offset, il[offset + 1] | (il[offset + 2] << 8) | (il[offset + 3] << 16) | (il[offset + 4] << 24));
+            offset += size;
+        }
+        return calls;
+    }
+
+    std::string ShortName(const WCHAR *name)
+    {
+        std::string s = to_utf8(name);
+        size_t dot = s.find_last_of('.');
+        return dot == std::string::npos ? s : s.substr(dot + 1);
+    }
+
+    // "Type.Method" for the token of a call instruction.
+    std::string CallName(ICorDebugModule *pModule, mdToken token)
+    {
+        ToRelease<IUnknown> pUnknown;
+        ToRelease<IMetaDataImport2> pMD;
+        if (FAILED(pModule->GetMetaDataInterface(IID_IMetaDataImport, &pUnknown)) ||
+            FAILED(pUnknown->QueryInterface(IID_IMetaDataImport2, (LPVOID *)&pMD)))
+            return "?";
+
+        if (TypeFromToken(token) == mdtMethodSpec)
+        {
+            mdToken parent = mdTokenNil;
+            if (FAILED(pMD->GetMethodSpecProps(token, &parent, nullptr, nullptr)))
+                return "?";
+            token = parent;
+        }
+        WCHAR methodName[mdNameLen] = {0};
+        WCHAR typeName[mdNameLen] = {0};
+        ULONG len = 0;
+        mdToken owner = mdTokenNil;
+        if (TypeFromToken(token) == mdtMethodDef)
+            pMD->GetMethodProps(token, &owner, methodName, _countof(methodName), &len, nullptr, nullptr, nullptr, nullptr, nullptr);
+        else if (TypeFromToken(token) == mdtMemberRef)
+            pMD->GetMemberRefProps(token, &owner, methodName, _countof(methodName), &len, nullptr, nullptr);
+
+        if (TypeFromToken(owner) == mdtTypeDef)
+            pMD->GetTypeDefProps(owner, typeName, _countof(typeName), &len, nullptr, nullptr);
+        else if (TypeFromToken(owner) == mdtTypeRef)
+            pMD->GetTypeRefProps(owner, nullptr, typeName, _countof(typeName), &len);
+
+        std::string method = to_utf8(methodName);
+        return typeName[0] ? ShortName(typeName) + "." + method : method;
+    }
+
+    HRESULT ReadILCode(ICorDebugFunction *pFunction, std::vector<BYTE> &il)
+    {
+        HRESULT Status;
+        ToRelease<ICorDebugCode> pCode;
+        IfFailRet(pFunction->GetILCode(&pCode));
+        ULONG32 size = 0;
+        IfFailRet(pCode->GetSize(&size));
+        il.resize(size);
+        ULONG32 fetched = 0;
+        IfFailRet(pCode->GetCode(0, size, size, il.data(), &fetched));
+        il.resize(fetched);
+        return S_OK;
+    }
+}
