+        // Reference types keep a strong handle, so the object can be expanded at the stop.
+        ToRelease<ICorDebugReferenceValue> pRef;
+        BOOL isNull = TRUE;
+        if (SUCCEEDED(pValue->QueryInterface(IID_ICorDebugReferenceValue, (LPVOID *)&pRef)) &&
+            SUCCEEDED(pRef->IsNull(&isNull)) && !isNull)
+        {
+            ToRelease<ICorDebugValue> pTarget;
+            ToRelease<ICorDebugHeapValue2> pHeap;
+            if (SUCCEEDED(pRef->Dereference(&pTarget)) &&
+                SUCCEEDED(pTarget->QueryInterface(IID_ICorDebugHeapValue2, (LPVOID *)&pHeap)))
+            {
+                pHeap->CreateHandle(HANDLE_STRONG, &stored.pHandle);
+            }
+        }
+
+        std::lock_guard<std::mutex> lock(g_returnValuesMutex);
+        g_returnValues.push_back(stored);
+    }
