+void ForEachReturnValue(ThreadId threadId, const std::function<void(const std::string &name, const std::string &value,
+                                                                    const std::string &type, ICorDebugValue *pValue)> &callback)
+{
+    std::lock_guard<std::mutex> lock(g_returnValuesMutex);
+    for (auto &v : g_returnValues)
+    {
+        if (v.threadId == threadId)
+            callback(v.name + " returned", v.value, v.type, v.pHandle);
+    }
+}
