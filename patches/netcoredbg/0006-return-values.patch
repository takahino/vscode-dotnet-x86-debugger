+    void StoreReturnValue(const std::string &name, ICorDebugValue *pValue, ThreadId threadId)
+    {
+        StoredReturnValue stored{name, "", "", nullptr, threadId};
+        // Printed now: the value object is neutered when the process continues to the end of the step.
+        // PrintValue does not run code in the debuggee, which must not happen in the middle of a step.
+        if (FAILED(PrintValue(pValue, stored.value)))
