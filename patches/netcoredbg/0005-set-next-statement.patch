+HRESULT ManagedDebugger::SetNextStatement(ThreadId threadId, const std::string &sourcePath, int line)
+{
+    LogFuncEntry();
+
+    std::lock_guard<Utility::RWLock::Reader> guardProcessRWLock(m_debugProcessRWLock.reader);
+    HRESULT Status;
+    IfFailRet(CheckDebugProcess());
+
+    if (m_sharedEvalWaiter->IsEvalRunning() || m_sharedCallbacksQueue->IsRunning())
+    {
+        LOGW("Can't 'Set Next Statement', process is running.");
+        return E_FAIL;
+    }
+
+    ToRelease<ICorDebugThread> pThread;
+    IfFailRet(m_iCorProcess->GetThread(int(threadId), &pThread));
+    ToRelease<ICorDebugFrame> pFrame;
+    IfFailRet(pThread->GetActiveFrame(&pFrame));
+    if (pFrame == nullptr)
+        return E_FAIL;
+    ToRelease<ICorDebugILFrame> pILFrame;
+    IfFailRet(pFrame->QueryInterface(IID_ICorDebugILFrame, (LPVOID *) &pILFrame));
+    ToRelease<ICorDebugFunction> pFunction;
+    IfFailRet(pFrame->GetFunction(&pFunction));
+    mdMethodDef methodToken = mdMethodDefNil;
+    IfFailRet(pFunction->GetToken(&methodToken));
+    ToRelease<ICorDebugModule> pModule;
+    IfFailRet(pFunction->GetModule(&pModule));
+    CORDB_ADDRESS modAddress = 0;
+    IfFailRet(pModule->GetBaseAddress(&modAddress));
+
+    // Same source -> IL resolution as line breakpoints; only a line of the method that is executing can be the target.
+    unsigned fullnameIndex = 0;
+    std::vector<ModulesSources::resolved_bp_t> resolvedPoints;
+    IfFailRet(m_sharedModules->ResolveBreakpoint(modAddress, sourcePath, fullnameIndex, line, resolvedPoints));
+    for (const auto &point : resolvedPoints)
+    {
+        if (point.methodToken != methodToken)
+            continue;
+        // CanSetIP rejects targets the runtime can't safely move to (e.g. into a catch / finally block).
+        IfFailRet(pILFrame->CanSetIP(point.ilOffset));
+        IfFailRet(pILFrame->SetIP(point.ilOffset));
+        // Frames and variables collected at this stop describe the old position.
+        m_sharedVariables->Clear();
+        FrameId::invalidate();
+        return S_OK;
+    }
+    LOGW("Set Next Statement: line %d is not in the executing method.", line);
+    return E_INVALIDARG;
+}
