+HRESULT ManagedDebugger::GetHeapStatistics(std::vector<std::tuple<std::string, uint64_t, uint64_t>> &types)
+{
+    LogFuncEntry();
+
+    std::lock_guard<Utility::RWLock::Reader> guardProcessRWLock(m_debugProcessRWLock.reader);
+    HRESULT Status;
+    IfFailRet(CheckDebugProcess());
+
+    ToRelease<ICorDebugProcess5> pProcess5;
+    IfFailRet(m_iCorProcess->QueryInterface(IID_ICorDebugProcess5, (LPVOID *) &pProcess5));
+    COR_HEAPINFO heapInfo;
+    IfFailRet(pProcess5->GetGCHeapInformation(&heapInfo));
+    // The heap can only be walked where the runtime keeps it consistent (not in the middle of a GC, for example).
+    if (!heapInfo.areGCStructuresValid)
+        return CORDBG_E_GC_STRUCTURES_INVALID;
+
+    // Count and size by type id first (cheap), then resolve each id to a name once.
+    struct TypeIdHash
+    {
+        size_t operator()(const std::pair<UINT64, UINT64> &id) const { return std::hash<UINT64>()(id.first) ^ (std::hash<UINT64>()(id.second) << 1); }
+    };
+    std::unordered_map<std::pair<UINT64, UINT64>, std::pair<uint64_t, uint64_t>, TypeIdHash> byId;
+    ToRelease<ICorDebugHeapEnum> pHeap;
+    IfFailRet(pProcess5->EnumerateHeap(&pHeap));
+    COR_HEAPOBJECT objects[512];
+    ULONG fetched = 0;
+    while (SUCCEEDED(pHeap->Next(_countof(objects), objects, &fetched)) && fetched > 0)
+    {
+        for (ULONG i = 0; i < fetched; i++)
+        {
+            auto &entry = byId[std::make_pair(objects[i].type.token1, objects[i].type.token2)];
+            entry.first++;
+            entry.second += objects[i].size;
+        }
+    }
+
+    // Generic instantiations may share a printed name: sum them up by name. GetTypeOfValue also names arrays and
+    // primitives (int[], string); free space between objects has no type and is counted as "?".
+    std::unordered_map<std::string, std::pair<uint64_t, uint64_t>> byName;
+    for (auto &entry : byId)
+    {
+        COR_TYPEID id;
+        id.token1 = entry.first.first;
+        id.token2 = entry.first.second;
+        std::string name;
+        ToRelease<ICorDebugType> pType;
+        if (FAILED(pProcess5->GetTypeForTypeID(id, &pType)) || FAILED(TypePrinter::GetTypeOfValue(pType, name)) || name.empty())
+            name = "?";
+        auto &total = byName[name];
+        total.first += entry.second.first;
+        total.second += entry.second.second;
+    }
+
+    types.clear();
+    for (auto &entry : byName)
+        types.emplace_back(entry.first, entry.second.first, entry.second.second);
+    std::sort(types.begin(), types.end(), [](const std::tuple<std::string, uint64_t, uint64_t> &a, const std::tuple<std::string, uint64_t, uint64_t> &b)
+    {
+        return std::get<2>(a) > std::get<2>(b);
+    });
+    return S_OK;
+}
