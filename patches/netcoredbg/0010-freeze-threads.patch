+// Threads the user froze ("Freeze Thread" of the .NET x86 Debugger extension). Function evaluation suspends every
+// other thread and lets them run again afterwards; a frozen thread must stay suspended.
+static std::mutex g_frozenThreadsMutex;
+static std::unordered_set<DWORD> g_frozenThreads;
+
+void SetThreadFrozenFlag(DWORD threadId, bool frozen)
+{
+    std::lock_guard<std::mutex> lock(g_frozenThreadsMutex);
+    if (frozen)
+        g_frozenThreads.insert(threadId);
+    else
+        g_frozenThreads.erase(threadId);
+}
+
+static bool IsThreadFrozen(DWORD threadId)
+{
+    std::lock_guard<std::mutex> lock(g_frozenThreadsMutex);
+    return g_frozenThreads.count(threadId) != 0;
+}
