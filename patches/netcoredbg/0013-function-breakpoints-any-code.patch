+HRESULT FuncBreakpoints::ManagedCallbackLoadModuleAnyCode(ICorDebugModule *pModule, std::vector<BreakpointEvent> &events)
+{
+    std::lock_guard<std::mutex> lock(m_breakpointsMutex);
+
+    for (auto &funcBreakpoints : m_funcBreakpoints)
+    {
+        ManagedFuncBreakpoint &fb = funcBreakpoints.second;
+
+        if (!fb.anyCode)
+            continue;
+
+        size_t bound = fb.funcBreakpoints.size();
+        ResolveAnyCodeBreakpointInModule(pModule, fb);
+        if (fb.funcBreakpoints.size() == bound)
+            continue;
+
+        Breakpoint breakpoint;
+        fb.ToBreakpoint(breakpoint);
+        events.emplace_back(BreakpointChanged, breakpoint);
+    }
+
+    return S_OK;
+}
+
+// The name of an "anyCode" breakpoint is "Namespace.Type.Method" in full (a top level type): the type is looked up
+// by name instead of comparing every method of the module, since this runs for every module the process loads.
+HRESULT FuncBreakpoints::ResolveAnyCodeBreakpointInModule(ICorDebugModule *pModule, ManagedFuncBreakpoint &fbp)
+{
+    HRESULT Status;
+
+    std::size_t dot = fbp.name.rfind('.');
+    if (dot == std::string::npos || dot == 0 || dot + 1 >= fbp.name.size())
+        return E_INVALIDARG;
+
+    if (!fbp.module.empty())
+    {
+        IfFailRet(IsModuleHaveSameName(pModule, fbp.module, IsFullPath(fbp.module)));
+        if (Status == S_FALSE)
+            return S_FALSE;
+    }
+
+    ToRelease<IUnknown> pMDUnknown;
+    IfFailRet(pModule->GetMetaDataInterface(IID_IMetaDataImport, &pMDUnknown));
+    ToRelease<IMetaDataImport> pMD;
+    IfFailRet(pMDUnknown->QueryInterface(IID_IMetaDataImport, (LPVOID*) &pMD));
+
+    WSTRING typeName = to_utf16(fbp.name.substr(0, dot));
+    WSTRING methodName = to_utf16(fbp.name.substr(dot + 1));
+
+    mdTypeDef typeDef = mdTypeDefNil;
+    if (FAILED(pMD->FindTypeDefByName(typeName.c_str(), mdTypeDefNil, &typeDef)) || typeDef == mdTypeDefNil)
+        return S_FALSE; // most modules do not have the type
+
+    ResolvedFBP fbpResolved;
+    HCORENUM hEnum = NULL;
+    mdMethodDef methodDef = mdMethodDefNil;
+    ULONG fetched = 0;
+    while (SUCCEEDED(pMD->EnumMethodsWithName(&hEnum, typeDef, methodName.c_str(), &methodDef, 1, &fetched)) && fetched == 1)
+    {
+        fbpResolved.emplace_back(std::make_pair(pModule, methodDef));
+    }
+    pMD->CloseEnum(hEnum);
+
+    return AddFuncBreakpoint(fbp, fbpResolved);
+}
