diff --git a/src/debugger/valueprint.cpp b/src/debugger/valueprint.cpp
index 3d1dad4..f6900d6 100644
--- a/src/debugger/valueprint.cpp
+++ b/src/debugger/valueprint.cpp
@@ -22,6 +22,26 @@
 namespace netcoredbg
 {
 
+// Dereferencing a void* that points to valid memory never returns (seen with WinForms'
+// NativeWindow._windowProcHandle on x86), and the pointee has no type to show anyway,
+// so void pointers are treated as opaque addresses.
+bool IsVoidPointer(ICorDebugValue *pValue)
+{
+    CorElementType corType;
+    if (FAILED(pValue->GetType(&corType)) || corType != ELEMENT_TYPE_PTR)
+        return false;
+
+    ToRelease<ICorDebugValue2> pValue2;
+    ToRelease<ICorDebugType> pType;
+    ToRelease<ICorDebugType> pPointeeType;
+    CorElementType pointeeCorType;
+    return SUCCEEDED(pValue->QueryInterface(IID_ICorDebugValue2, (LPVOID *) &pValue2)) &&
+           SUCCEEDED(pValue2->GetExactType(&pType)) &&
+           SUCCEEDED(pType->GetFirstTypeParameter(&pPointeeType)) &&
+           SUCCEEDED(pPointeeType->GetType(&pointeeCorType)) &&
+           pointeeCorType == ELEMENT_TYPE_VOID;
+}
