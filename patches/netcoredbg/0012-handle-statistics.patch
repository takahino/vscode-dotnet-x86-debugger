+HRESULT ManagedDebugger::GetHandleStatistics(const std::vector<std::pair<std::string, std::string>> &fields,
+                                             std::vector<std::tuple<std::string, uint64_t, uint64_t, std::string>> &types)
+{
+    LogFuncEntry();
+
+    std::lock_guard<Utility::RWLock::Reader> guardProcessRWLock(m_debugProcessRWLock.reader);
+    HRESULT Status;
+    IfFailRet(CheckDebugProcess());
+
+    ToRelease<ICorDebugProcess5> pProcess5;
+    IfFailRet(m_iCorProcess->QueryInterface(IID_ICorDebugProcess5, (LPVOID *) &pProcess5));
+    COR_HEAPINFO heapInfo;
+    IfFailRet(pProcess5->GetGCHeapInformation(&heapInfo));
+    if (!heapInfo.areGCStructuresValid)
+        return CORDBG_E_GC_STRUCTURES_INVALID;
+
+    // Per type id: where its objects keep one of the requested handle fields (found once), and the counts.
+    struct Layout
+    {
+        bool resolved = false;
+        bool hasField = false;
+        ULONG32 offset = 0;
+        std::string field;
+        uint64_t count = 0;
+        uint64_t live = 0;
+    };
+    struct TypeIdHash
+    {
+        size_t operator()(const std::pair<UINT64, UINT64> &id) const { return std::hash<UINT64>()(id.first) ^ (std::hash<UINT64>()(id.second) << 1); }
+    };
+    std::unordered_map<std::pair<UINT64, UINT64>, Layout, TypeIdHash> byId;
+
+    // The field may be declared by a base type (Bitmap keeps Image's native image): walk the type and its parents,
+    // and match the field by the name of its declaring type and its own name.
+    auto resolve = [&](COR_TYPEID id, Layout &layout)
+    {
+        layout.resolved = true;
+        for (COR_TYPEID current = id; current.token1 != 0 || current.token2 != 0; )
+        {
+            COR_TYPE_LAYOUT typeLayout;
+            if (FAILED(pProcess5->GetTypeLayout(current, &typeLayout)))
+                return;
+            std::vector<COR_FIELD> list(typeLayout.numFields);
+            ULONG32 count = 0;
+            ToRelease<ICorDebugType> pType;
+            ToRelease<ICorDebugClass> pClass;
+            ToRelease<ICorDebugModule> pModule;
+            ToRelease<IUnknown> pMDUnknown;
+            ToRelease<IMetaDataImport> pMD;
+            if (typeLayout.numFields > 0 &&
+                SUCCEEDED(pProcess5->GetTypeFields(current, typeLayout.numFields, list.data(), &count)) &&
+                SUCCEEDED(pProcess5->GetTypeForTypeID(current, &pType)) &&
+                SUCCEEDED(pType->GetClass(&pClass)) &&
+                SUCCEEDED(pClass->GetModule(&pModule)) &&
+                SUCCEEDED(pModule->GetMetaDataInterface(IID_IMetaDataImport, &pMDUnknown)) &&
+                SUCCEEDED(pMDUnknown->QueryInterface(IID_IMetaDataImport, (LPVOID *) &pMD)))
+            {
+                for (ULONG32 i = 0; i < count && i < list.size(); i++)
+                {
+                    WCHAR fieldName[mdNameLen] = {0};
+                    ULONG fieldNameLen = 0;
+                    mdTypeDef declaring = mdTypeDefNil;
+                    DWORD attr = 0;
+                    if (FAILED(pMD->GetFieldProps(list[i].token, &declaring, fieldName, _countof(fieldName), &fieldNameLen, &attr, NULL, NULL, NULL, NULL, NULL)) ||
+                        IsFdStatic(attr))
+                        continue;
+                    WCHAR className[mdNameLen] = {0};
+                    ULONG classNameLen = 0;
+                    if (FAILED(pMD->GetTypeDefProps(declaring, className, _countof(className), &classNameLen, NULL, NULL)))
+                        continue;
+                    auto key = std::make_pair(to_utf8(className), to_utf8(fieldName));
+                    if (std::find(fields.begin(), fields.end(), key) != fields.end())
+                    {
+                        layout.hasField = true;
+                        layout.offset = list[i].offset;
+                        layout.field = key.first + "." + key.second;
+                        return;
+                    }
+                }
+            }
+            current = typeLayout.parentID;
+        }
+    };
+
+    ToRelease<ICorDebugHeapEnum> pHeap;
+    IfFailRet(pProcess5->EnumerateHeap(&pHeap));
+    COR_HEAPOBJECT objects[512];
+    ULONG fetched = 0;
+    while (SUCCEEDED(pHeap->Next(_countof(objects), objects, &fetched)) && fetched > 0)
+    {
+        for (ULONG i = 0; i < fetched; i++)
+        {
+            if (objects[i].type.token1 == 0 && objects[i].type.token2 == 0)
+                continue; // free space between objects
+            auto &layout = byId[std::make_pair(objects[i].type.token1, objects[i].type.token2)];
+            if (!layout.resolved)
+                resolve(objects[i].type, layout);
+            if (!layout.hasField)
+                continue;
+            layout.count++;
+            // netcoredbg and the debuggee have the same bitness: a handle is pointer-sized. Dispose sets it to 0.
+            void *handle = nullptr;
+            SIZE_T read = 0;
+            if (SUCCEEDED(m_iCorProcess->ReadMemory(objects[i].address + layout.offset, sizeof(handle), (BYTE *) &handle, &read)) &&
+                read == sizeof(handle) && handle != nullptr)
+                layout.live++;
+        }
+    }
+
+    std::map<std::string, std::tuple<uint64_t, uint64_t, std::string>> byName;
+    for (auto &entry : byId)
+    {
+        if (!entry.second.hasField)
+            continue;
+        COR_TYPEID id;
+        id.token1 = entry.first.first;
+        id.token2 = entry.first.second;
+        std::string name;
+        ToRelease<ICorDebugType> pType;
+        if (FAILED(pProcess5->GetTypeForTypeID(id, &pType)) || FAILED(TypePrinter::GetTypeOfValue(pType, name)) || name.empty())
+            name = "?";
+        auto &total = byName[name];
+        std::get<0>(total) += entry.second.count;
+        std::get<1>(total) += entry.second.live;
+        std::get<2>(total) = entry.second.field;
+    }
+    types.clear();
+    for (auto &entry : byName)
+        types.emplace_back(entry.first, std::get<0>(entry.second), std::get<1>(entry.second), std::get<2>(entry.second));
+    return S_OK;
+}
+
 // Defined in evalwaiter.cpp (frozen threads stay suspended after function evaluation).
 void SetThreadFrozenFlag(DWORD threadId, bool frozen);
 
