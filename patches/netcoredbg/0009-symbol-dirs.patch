+        /// <summary>
+        /// Looks for &lt;dir&gt;/&lt;MVID&gt;/symbols.pdb in the folders listed in NETCOREDBG_SYMBOL_DIRS (separated like PATH).
+        /// The MVID identifies the exact build of the assembly, so this also works for assemblies built without a PDB
+        /// (no CodeView entry); when there is a CodeView entry, the PDB id must match it as usual.
+        /// </summary>
+        private static OpenedReader TryOpenReaderFromSymbolDirs(PEReader peReader, DebugDirectoryEntry codeViewEntry)
+        {
+            string dirs = Environment.GetEnvironmentVariable("NETCOREDBG_SYMBOL_DIRS");
+            if (string.IsNullOrEmpty(dirs) || !peReader.HasMetadata)
+            {
+                return null;
+            }
+
+            MetadataReader metadata = peReader.GetMetadataReader();
+            Guid mvid = metadata.GetGuid(metadata.GetModuleDefinition().Mvid);
+            foreach (string dir in dirs.Split(new[] { Path.PathSeparator }, StringSplitOptions.RemoveEmptyEntries))
+            {
+                Stream pdbStream;
+                try
+                {
+                    pdbStream = TryOpenFile(Path.Combine(dir, mvid.ToString("D"), "symbols.pdb"));
+                }
+                catch (ArgumentException)
+                {
+                    continue; // invalid characters in the folder
+                }
+                if (pdbStream == null)
+                {
+                    continue;
+                }
+
+                MetadataReaderProvider provider = null;
+                try
+                {
+                    provider = MetadataReaderProvider.FromPortablePdbStream(pdbStream);
+                    MetadataReader reader = provider.GetMetadataReader();
+                    if (codeViewEntry.DataSize != 0)
+                    {
+                        var data = peReader.ReadCodeViewDebugDirectoryData(codeViewEntry);
+                        if (new BlobContentId(reader.DebugMetadataHeader.Id) != new BlobContentId(data.Guid, codeViewEntry.Stamp))
+                        {
+                            provider.Dispose();
+                            continue;
+                        }
+                    }
+                    return new OpenedReader(provider, reader);
+                }
+                catch (Exception e) when (e is BadImageFormatException || e is IOException)
+                {
+                    provider?.Dispose();
+                }
+            }
+            return null;
+        }
+
