<Project Sdk="Microsoft.NET.Sdk">

  <!-- Its PDB records C:\fake\src\MappedLib\... (as if built on another machine), for the source mapping tests. -->
  <PropertyGroup>
    <!-- net48 too: the E2E tests also run against .NET Framework apps (DOTNETX86_E2E_FRAMEWORK=net48). -->
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <DebugType>portable</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=C:\fake\src\MappedLib</PathMap>
  </PropertyGroup>

</Project>
