{
  "name": "dotnet-x86-debugger",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "takahino",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2b1670",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/takahino/vscode-dotnet-x86-debugger.git"
  },
  "bugs": {
    "url": "https://github.com/takahino/vscode-dotnet-x86-debugger/issues"
  },
  "homepage": "https://github.com/takahino/vscode-dotnet-x86-debugger#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers"
  ],
  "keywords": [
    "dotnet",
    ".NET",
    ".NET Framework",
    "x86",
    "32-bit",
    "WinForms",
    "netcoredbg",
    "C#",
    "csharp",
    "debugger",
    "debug"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onDebugResolve:dotnet-x86",
    "onDebugDynamicConfigurations:dotnet-x86",
    "onDebugInitialConfigurations",
    "onCommand:dotnetX86.trackValue",
    "onCommand:dotnetX86.showValueTrend",
    "onCommand:dotnetX86.startTimer",
    "onCommand:dotnetX86.endTimer",
    "onCommand:dotnetX86.addTemporaryBreakpoint",
    "onCommand:dotnetX86.addDependentBreakpoint",
    "onCommand:dotnetX86.addWhenChangedBreakpoint",
    "onCommand:dotnetX86.addCallerBreakpoint",
    "onCommand:dotnetX86.highlightControl",
    "onCommand:dotnetX86.showDataBindings",
    "onCommand:dotnetX86.generateTest",
    "onCommand:dotnetX86.makeObjectId",
    "onCommand:dotnetX86.decompileModule",
    "onCommand:dotnetX86.clearDecompiled",
    "onCommand:dotnetX86.downloadSymbols",
    "onCommand:dotnetX86.showParallelStacks",
    "onCommand:dotnetX86.showHeapSnapshots",
    "onCommand:dotnetX86.checkEnvironment",
    "onCommand:dotnetX86.generateLaunchJson",
    "onCommand:dotnetX86.gettingStarted",
    "onCommand:dotnetX86.takeHeapSnapshot",
    "onCommand:dotnetX86.clearDownloadedSymbols",
    "onCommand:dotnetX86.addExceptionType",
    "onCommand:dotnetX86.pinValue",
    "onCommand:dotnetX86.unpinValue",
    "onCommand:dotnetX86.clearPinnedValues",
    "onCommand:dotnetX86.exportSessionReport"
  ],
  "contributes": {
    "walkthroughs": [
      {
        "id": "dotnetX86.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "environment",
            "title": "%walkthrough.environment.title%",
            "description": "%walkthrough.environment.description%",
            "media": {
              "markdown": "%walkthrough.environment.media%"
            },
            "completionEvents": [
              "onCommand:dotnetX86.checkEnvironment"
            ]
          },
          {
            "id": "project",
            "title": "%walkthrough.project.title%",
            "description": "%walkthrough.project.description%",
            "media": {
              "markdown": "%walkthrough.project.media%"
            },
            "completionEvents": [
              "onCommand:dotnetX86.checkEnvironment"
            ]
          },
          {
            "id": "launch",
            "title": "%walkthrough.launch.title%",
            "description": "%walkthrough.launch.description%",
            "media": {
              "markdown": "%walkthrough.launch.media%"
            },
            "completionEvents": [
              "onCommand:dotnetX86.generateLaunchJson"
            ]
          },
          {
            "id": "debug",
            "title": "%walkthrough.debug.title%",
            "description": "%walkthrough.debug.description%",
            "media": {
              "markdown": "%walkthrough.debug.media%"
            },
            "completionEvents": [
              "onDebugStart"
            ]
          },
          {
            "id": "features",
            "title": "%walkthrough.features.title%",
            "description": "%walkthrough.features.description%",
            "media": {
              "markdown": "%walkthrough.features.media%"
            },
            "completionEvents": [
              "onLink:https://takahino.github.io/vscode-dotnet-x86-debugger/usage.html"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "dotnetX86.gettingStarted",
        "title": "%command.gettingStarted%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.checkEnvironment",
        "title": "%command.checkEnvironment%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.generateLaunchJson",
        "title": "%command.generateLaunchJson%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.dumpVariable",
        "title": "%command.dumpVariable%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.dumpExpression",
        "title": "%command.dumpExpression%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.copyAsCSharp",
        "title": "%command.copyAsCSharp%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.decompileModule",
        "title": "%command.decompileModule%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.showParallelStacks",
        "title": "%command.showParallelStacks%",
        "category": ".NET x86",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dotnetX86.showHeapSnapshots",
        "title": "%command.showHeapSnapshots%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.takeHeapSnapshot",
        "title": "%command.takeHeapSnapshot%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.freezeThread",
        "title": "%command.freezeThread%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.thawThread",
        "title": "%command.thawThread%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.downloadSymbols",
        "title": "%command.downloadSymbols%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.clearDownloadedSymbols",
        "title": "%command.clearDownloadedSymbols%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.clearDecompiled",
        "title": "%command.clearDecompiled%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.makeObjectId",
        "title": "%command.makeObjectId%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.generateTest",
        "title": "%command.generateTest%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.viewString",
        "title": "%command.viewString%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.takeSnapshot",
        "title": "%command.takeSnapshot%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.compareWithSnapshot",
        "title": "%command.compareWithSnapshot%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.showMemoryGraph",
        "title": "%command.showMemoryGraph%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.trackValue",
        "title": "%command.trackValue%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.showValueTrend",
        "title": "%command.showValueTrend%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.clearStepHistory",
        "title": "%command.clearStepHistory%",
        "category": ".NET x86",
        "icon": "$(clear-all)"
      },
      {
        "command": "dotnetX86.viewAsTable",
        "title": "%command.viewAsTable%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.viewAsImage",
        "title": "%command.viewAsImage%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.copyModulePath",
        "title": "%command.copyModulePath%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.revealModule",
        "title": "%command.revealModule%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.addExceptionType",
        "title": "%command.addExceptionType%",
        "category": ".NET x86",
        "icon": "$(add)"
      },
      {
        "command": "dotnetX86.removeExceptionType",
        "title": "%command.removeExceptionType%",
        "category": ".NET x86",
        "icon": "$(trash)"
      },
      {
        "command": "dotnetX86.uncheckExceptionTypes",
        "title": "%command.uncheckExceptionTypes%",
        "category": ".NET x86",
        "icon": "$(clear-all)"
      },
      {
        "command": "dotnetX86.breakOnExceptionType",
        "title": "%command.breakOnExceptionType%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.clearExceptionLog",
        "title": "%command.clearExceptionLog%",
        "category": ".NET x86",
        "icon": "$(clear-all)"
      },
      {
        "command": "dotnetX86.startTimer",
        "title": "%command.startTimer%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.endTimer",
        "title": "%command.endTimer%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.addTemporaryBreakpoint",
        "title": "%command.addTemporaryBreakpoint%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.addDependentBreakpoint",
        "title": "%command.addDependentBreakpoint%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.addWhenChangedBreakpoint",
        "title": "%command.addWhenChangedBreakpoint%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.addCallerBreakpoint",
        "title": "%command.addCallerBreakpoint%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.pinValue",
        "title": "%command.pinValue%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.unpinValue",
        "title": "%command.unpinValue%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.clearPinnedValues",
        "title": "%command.clearPinnedValues%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.refreshControlTree",
        "title": "%command.refreshControlTree%",
        "category": ".NET x86",
        "icon": "$(refresh)"
      },
      {
        "command": "dotnetX86.breakOnControlEvent",
        "title": "%command.breakOnControlEvent%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.editControlProperty",
        "title": "%command.editControlProperty%",
        "category": ".NET x86",
        "icon": "$(edit)"
      },
      {
        "command": "dotnetX86.highlightControl",
        "title": "%command.highlightControl%",
        "category": ".NET x86",
        "icon": "$(eye)"
      },
      {
        "command": "dotnetX86.showDataBindings",
        "title": "%command.showDataBindings%",
        "category": ".NET x86",
        "icon": "$(link)"
      },
      {
        "command": "dotnetX86.dumpControl",
        "title": "%command.dumpControl%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.copyControlExpression",
        "title": "%command.copyControlExpression%",
        "category": ".NET x86"
      },
      {
        "command": "dotnetX86.exportSessionReport",
        "title": "%command.exportSessionReport%",
        "category": ".NET x86",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "debug/watch/context": [
        {
          "command": "dotnetX86.viewAsImage",
          "when": "debugType == 'dotnet-x86'",
          "group": "z_dotnetX86@1"
        },
        {
          "command": "dotnetX86.makeObjectId",
          "when": "debugType == 'dotnet-x86'",
          "group": "z_dotnetX86@0"
        }
      ],
      "debug/callstack/context": [
        {
          "command": "dotnetX86.freezeThread",
          "when": "debugType == 'dotnet-x86' && callStackItemType == 'thread'",
          "group": "z_dotnetX86@1"
        },
        {
          "command": "dotnetX86.thawThread",
          "when": "debugType == 'dotnet-x86' && callStackItemType == 'thread'",
          "group": "z_dotnetX86@2"
        },
        {
          "command": "dotnetX86.showParallelStacks",
          "when": "debugType == 'dotnet-x86'",
          "group": "z_dotnetX86@3"
        },
        {
          "command": "dotnetX86.takeHeapSnapshot",
          "when": "debugType == 'dotnet-x86'",
          "group": "z_dotnetX86@4"
        },
        {
          "command": "dotnetX86.generateTest",
          "when": "debugType == 'dotnet-x86' && callStackItemType == 'stackFrame'",
          "group": "z_dotnetX86@1"
        }
      ],
      "debug/variables/context": [
        {
          "command": "dotnetX86.makeObjectId",
          "when": "debugType == 'dotnet-x86'",
          "group": "z_dotnetX86@0"
        },
        {
          "command": "dotnetX86.dumpVariable",
          "when": "debugType == 'dotnet-x86'",
          "group": "z_dotnetX86@1"
        },
        {
          "command": "dotnetX86.viewAsTable",
          "when": "debugType == 'dotnet-x86'",
          "group": "z_dotnetX86@2"
        },
        {
          "command": "dotnetX86.viewAsImage",
          "when": "debugType == 'dotnet-x86'",
          "group": "z_dotnetX86@2"
        },
        {
          "command": "dotnetX86.copyAsCSharp",
          "when": "debugType == 'dotnet-x86'",
          "group": "z_dotnetX86@3"
        },
        {
          "command": "dotnetX86.viewString",
          "when": "debugType == 'dotnet-x86'",
          "group": "z_dotnetX86@4"
        },
        {
          "command": "dotnetX86.takeSnapshot",
          "when": "debugType == 'dotnet-x86'",
          "group": "z_dotnetX86@5"
        },
        {
          "command": "dotnetX86.compareWithSnapshot",
          "when": "debugType == 'dotnet-x86'",
          "group": "z_dotnetX86@6"
        }
      ],
      "commandPalette": [
        {
          "command": "dotnetX86.dumpVariable",
          "when": "false"
        },
        {
          "command": "dotnetX86.copyAsCSharp",
          "when": "false"
        },
        {
          "command": "dotnetX86.makeObjectId",
          "when": "false"
        },
        {
          "command": "dotnetX86.generateTest",
          "when": "inDebugMode && debugType == 'dotnet-x86'"
        },
        {
          "command": "dotnetX86.freezeThread",
          "when": "inDebugMode && debugType == 'dotnet-x86'"
        },
        {
          "command": "dotnetX86.thawThread",
          "when": "inDebugMode && debugType == 'dotnet-x86'"
        },
        {
          "command": "dotnetX86.viewString",
          "when": "false"
        },
        {
          "command": "dotnetX86.takeSnapshot",
          "when": "false"
        },
        {
          "command": "dotnetX86.compareWithSnapshot",
          "when": "false"
        },
        {
          "command": "dotnetX86.dumpExpression",
          "when": "inDebugMode && debugState == 'stopped'"
        },
        {
          "command": "dotnetX86.trackValue",
          "when": "resourceLangId == csharp"
        },
        {
          "command": "dotnetX86.clearStepHistory",
          "when": "debugType == 'dotnet-x86'"
        },
        {
          "command": "dotnetX86.viewAsTable",
          "when": "false"
        },
        {
          "command": "dotnetX86.viewAsImage",
          "when": "false"
        },
        {
          "command": "dotnetX86.copyModulePath",
          "when": "false"
        },
        {
          "command": "dotnetX86.revealModule",
          "when": "false"
        },
        {
          "command": "dotnetX86.clearExceptionLog",
          "when": "debugType == 'dotnet-x86'"
        },
        {
          "command": "dotnetX86.removeExceptionType",
          "when": "false"
        },
        {
          "command": "dotnetX86.breakOnExceptionType",
          "when": "false"
        },
        {
          "command": "dotnetX86.startTimer",
          "when": "resourceLangId == csharp"
        },
        {
          "command": "dotnetX86.endTimer",
          "when": "resourceLangId == csharp"
        },
        {
          "command": "dotnetX86.addTemporaryBreakpoint",
          "when": "resourceLangId == csharp"
        },
        {
          "command": "dotnetX86.addDependentBreakpoint",
          "when": "resourceLangId == csharp"
        },
        {
          "command": "dotnetX86.addWhenChangedBreakpoint",
          "when": "resourceLangId == csharp"
        },
        {
          "command": "dotnetX86.addCallerBreakpoint",
          "when": "resourceLangId == csharp"
        },
        {
          "command": "dotnetX86.pinValue",
          "when": "resourceLangId == csharp"
        },
        {
          "command": "dotnetX86.unpinValue",
          "when": "resourceLangId == csharp"
        },
        {
          "command": "dotnetX86.refreshControlTree",
          "when": "false"
        },
        {
          "command": "dotnetX86.highlightControl",
          "when": "false"
        },
        {
          "command": "dotnetX86.editControlProperty",
          "when": "false"
        },
        {
          "command": "dotnetX86.breakOnControlEvent",
          "when": "false"
        },
        {
          "command": "dotnetX86.dumpControl",
          "when": "false"
        },
        {
          "command": "dotnetX86.copyControlExpression",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "dotnetX86.trackValue",
          "when": "resourceLangId == csharp",
          "group": "z_dotnetX86@1"
        },
        {
          "command": "dotnetX86.startTimer",
          "when": "resourceLangId == csharp",
          "group": "z_dotnetX86@2"
        },
        {
          "command": "dotnetX86.endTimer",
          "when": "resourceLangId == csharp",
          "group": "z_dotnetX86@3"
        },
        {
          "command": "dotnetX86.addTemporaryBreakpoint",
          "when": "resourceLangId == csharp",
          "group": "z_dotnetX86bp@1"
        },
        {
          "command": "dotnetX86.addDependentBreakpoint",
          "when": "resourceLangId == csharp",
          "group": "z_dotnetX86bp@2"
        },
        {
          "command": "dotnetX86.addWhenChangedBreakpoint",
          "when": "resourceLangId == csharp",
          "group": "z_dotnetX86bp@3"
        },
        {
          "command": "dotnetX86.addCallerBreakpoint",
          "when": "resourceLangId == csharp",
          "group": "z_dotnetX86bp@4"
        },
        {
          "command": "dotnetX86.pinValue",
          "when": "resourceLangId == csharp",
          "group": "z_dotnetX86pin@1"
        },
        {
          "command": "dotnetX86.unpinValue",
          "when": "resourceLangId == csharp",
          "group": "z_dotnetX86pin@2"
        }
      ],
      "view/title": [
        {
          "command": "dotnetX86.clearStepHistory",
          "when": "view == dotnetX86.stepHistory",
          "group": "navigation"
        },
        {
          "command": "dotnetX86.clearExceptionLog",
          "when": "view == dotnetX86.exceptions",
          "group": "navigation"
        },
        {
          "command": "dotnetX86.addExceptionType",
          "when": "view == dotnetX86.exceptionSettings",
          "group": "navigation@1"
        },
        {
          "command": "dotnetX86.uncheckExceptionTypes",
          "when": "view == dotnetX86.exceptionSettings",
          "group": "navigation@2"
        },
        {
          "command": "dotnetX86.showDataBindings",
          "when": "view == dotnetX86.controls",
          "group": "navigation@0"
        },
        {
          "command": "dotnetX86.refreshControlTree",
          "when": "view == dotnetX86.controls",
          "group": "navigation"
        },
        {
          "command": "dotnetX86.exportSessionReport",
          "when": "view == dotnetX86.stepHistory",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "dotnetX86.removeExceptionType",
          "when": "view == dotnetX86.exceptionSettings && viewItem == dotnetX86.exceptionType.custom",
          "group": "inline"
        },
        {
          "command": "dotnetX86.breakOnExceptionType",
          "when": "view == dotnetX86.exceptions && viewItem == dotnetX86.exception",
          "group": "z_dotnetX86@1"
        },
        {
          "command": "dotnetX86.copyModulePath",
          "when": "view == dotnetX86.modules",
          "group": "z_dotnetX86@1"
        },
        {
          "command": "dotnetX86.downloadSymbols",
          "when": "view == dotnetX86.modules && viewItem == dotnetX86.module.noSymbols",
          "group": "z_dotnetX86@0"
        },
        {
          "command": "dotnetX86.decompileModule",
          "when": "view == dotnetX86.modules && viewItem == dotnetX86.module.noSymbols",
          "group": "z_dotnetX86@0"
        },
        {
          "command": "dotnetX86.revealModule",
          "when": "view == dotnetX86.modules",
          "group": "z_dotnetX86@2"
        },
        {
          "command": "dotnetX86.highlightControl",
          "when": "view == dotnetX86.controls",
          "group": "inline"
        },
        {
          "command": "dotnetX86.highlightControl",
          "when": "view == dotnetX86.controls",
          "group": "z_dotnetX86@0"
        },
        {
          "command": "dotnetX86.editControlProperty",
          "when": "view == dotnetX86.controls",
          "group": "z_dotnetX86@0"
        },
        {
          "command": "dotnetX86.breakOnControlEvent",
          "when": "view == dotnetX86.controls",
          "group": "z_dotnetX86@0"
        },
        {
          "command": "dotnetX86.showDataBindings",
          "when": "view == dotnetX86.controls",
          "group": "z_dotnetX86@0"
        },
        {
          "command": "dotnetX86.dumpControl",
          "when": "view == dotnetX86.controls",
          "group": "z_dotnetX86@1"
        },
        {
          "command": "dotnetX86.copyControlExpression",
          "when": "view == dotnetX86.controls",
          "group": "z_dotnetX86@2"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "dotnetX86.debuggerPath": {
          "type": "string",
          "default": "",
          "description": "%config.debuggerPath%"
        },
        "dotnetX86.trace": {
          "type": "boolean",
          "default": false,
          "description": "%config.trace%"
        },
        "dotnetX86.sourceLink.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%config.sourceLink.enabled%"
        },
        "dotnetX86.symbolServers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "https://symbols.nuget.org/download/symbols",
            "https://msdl.microsoft.com/download/symbols"
          ],
          "description": "%config.symbolServers%"
        },
        "dotnetX86.sourceFileMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "resource",
          "markdownDescription": "%config.sourceFileMap%"
        },
        "dotnetX86.sourceSearchPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.sourceSearchPaths%"
        },
        "dotnetX86.memoryGraph.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "%config.memoryGraph.autoOpen%"
        },
        "dotnetX86.dump.maxDepth": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "description": "%config.dump.maxDepth%"
        },
        "dotnetX86.dump.maxNodes": {
          "type": "integer",
          "default": 2000,
          "minimum": 1,
          "description": "%config.dump.maxNodes%"
        },
        "dotnetX86.stepHistory.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.stepHistory.enabled%"
        },
        "dotnetX86.perfTips.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.perfTips.enabled%"
        },
        "dotnetX86.uiFreeze.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.uiFreeze.enabled%"
        },
        "dotnetX86.uiFreeze.thresholdMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "description": "%config.uiFreeze.thresholdMs%"
        },
        "dotnetX86.heapSnapshot.collectGarbage": {
          "type": "boolean",
          "default": true,
          "description": "%config.heapSnapshot.collectGarbage%"
        },
        "dotnetX86.exceptionLog.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.exceptionLog.enabled%"
        },
        "dotnetX86.exceptionLog.captureLocals": {
          "type": "boolean",
          "default": true,
          "description": "%config.exceptionLog.captureLocals%"
        }
      }
    },
    "breakpoints": [
      {
        "language": "csharp"
      },
      {
        "language": "fsharp"
      },
      {
        "language": "vb"
      }
    ],
    "debuggers": [
      {
        "type": "dotnet-x86",
        "label": "%debugger.label%",
        "languages": [
          "csharp",
          "fsharp",
          "vb"
        ],
        "variables": {
          "pickProcess": "dotnetX86.pickProcess"
        },
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "%debugger.launch.program%"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "%debugger.launch.args%"
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "%debugger.launch.cwd%"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "description": "%debugger.launch.env%"
              },
              "stopAtEntry": {
                "type": "boolean",
                "default": false,
                "description": "%debugger.launch.stopAtEntry%"
              },
              "justMyCode": {
                "type": "boolean",
                "default": true,
                "description": "%debugger.launch.justMyCode%"
              },
              "enableStepFiltering": {
                "type": "boolean",
                "default": true,
                "description": "%debugger.launch.enableStepFiltering%"
              },
              "sourceFileMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "markdownDescription": "%debugger.launch.sourceFileMap%"
              },
              "sourceSearchPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "markdownDescription": "%debugger.launch.sourceSearchPaths%"
              }
            }
          },
          "attach": {
            "required": [],
            "properties": {
              "processId": {
                "anyOf": [
                  {
                    "type": "string",
                    "default": "${command:pickProcess}"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "description": "%debugger.attach.processId%"
              },
              "justMyCode": {
                "type": "boolean",
                "default": true,
                "description": "%debugger.attach.justMyCode%"
              },
              "enableStepFiltering": {
                "type": "boolean",
                "default": true,
                "description": "%debugger.attach.enableStepFiltering%"
              },
              "sourceFileMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "markdownDescription": "%debugger.attach.sourceFileMap%"
              },
              "sourceSearchPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "markdownDescription": "%debugger.attach.sourceSearchPaths%"
              },
              "processName": {
                "type": "string",
                "description": "%debugger.attach.processName%"
              },
              "waitTimeout": {
                "type": "number",
                "default": 120,
                "description": "%debugger.attach.waitTimeout%"
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "%snippet.launch.label%",
            "description": "%snippet.launch.description%",
            "body": {
              "name": ".NET x86 Launch",
              "type": "dotnet-x86",
              "request": "launch",
              "preLaunchTask": "build",
              "program": "^\"\\${workspaceFolder}/bin/x86/Debug/net10.0-windows/\\${workspaceFolderBasename}.exe\"",
              "args": [],
              "cwd": "^\"\\${workspaceFolder}\"",
              "stopAtEntry": false
            }
          },
          {
            "label": "%snippet.attach.label%",
            "description": "%snippet.attach.description%",
            "body": {
              "name": ".NET x86 Attach",
              "type": "dotnet-x86",
              "request": "attach",
              "processId": "^\"\\${command:pickProcess}\""
            }
          },
          {
            "label": "%snippet.waitAttach.label%",
            "description": "%snippet.waitAttach.description%",
            "body": {
              "name": ".NET x86 Attach (wait for process)",
              "type": "dotnet-x86",
              "request": "attach",
              "processName": "MyApp",
              "waitTimeout": 120
            }
          }
        ]
      }
    ],
    "views": {
      "debug": [
        {
          "id": "dotnetX86.autos",
          "name": "%view.autos%",
          "when": "debugType == 'dotnet-x86'"
        },
        {
          "id": "dotnetX86.exceptions",
          "name": "%view.exceptions%",
          "when": "debugType == 'dotnet-x86'"
        },
        {
          "id": "dotnetX86.exceptionSettings",
          "name": "%view.exceptionSettings%",
          "when": "debugType == 'dotnet-x86'",
          "visibility": "collapsed"
        },
        {
          "id": "dotnetX86.stepHistory",
          "name": "%view.stepHistory%",
          "when": "debugType == 'dotnet-x86'"
        },
        {
          "id": "dotnetX86.controls",
          "name": "%view.controls%",
          "when": "debugType == 'dotnet-x86'",
          "visibility": "collapsed"
        },
        {
          "id": "dotnetX86.modules",
          "name": "%view.modules%",
          "when": "debugType == 'dotnet-x86'",
          "visibility": "collapsed"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test \"out/test/unit/**/*.test.js\"",
    "test:e2e": "tsc -p ./ && node --test --test-concurrency=1 \"out/test/e2e/**/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --target win32-x64 -o out/dotnet-x86-debugger.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0"
  },
  "l10n": "./l10n"
}
